{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "npm ci --include=dev && npm run build"
  },
  "deploy": {
    "startCommand": "npm start",
    "healthcheckPath": "/",
    "restartPolicyType": "on_failure"
  },
  "volumes": [
    {
      "name": "leaderboard-data",
      "mountPath": "/data"
    }
  ]
}
