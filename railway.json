{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm run build",
    "nixpacksPlan": {
      "variables": {
        "NPM_CONFIG_PRODUCTION": "false"
      }
    }
  },
  "deploy": {
    "startCommand": "npm start",
    "healthcheckPath": "/",
    "restartPolicyType": "on_failure"
  },
  "volumes": [
    {
      "name": "leaderboard-data",
      "mountPath": "/data"
    }
  ]
}
